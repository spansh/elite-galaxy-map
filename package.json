{
  "name": "elite-galaxy-map",
  "version": "0.1.0",
  "description": "Streaming three.js map of the Elite Dangerous galaxy that draws into any page element",
  "author": "Spansh",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./spansh-loader-worker.js": "./examples/spansh-loader/spansh-loader-worker.js",
    "./read-lines.js": {
      "types": "./types/read-lines.d.ts",
      "default": "./examples/spansh-loader/readLines.js"
    },
    "./star-classes.js": {
      "types": "./types/star-classes.d.ts",
      "default": "./examples/spansh-loader/starClasses.js"
    },
    "./spansh-route.js": {
      "types": "./types/spansh-route.d.ts",
      "default": "./src/spanshRoute.js"
    }
  },
  "files": [
    "src",
    "types",
    "assets",
    "examples/spansh-loader",
    "scripts",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "demo": "node scripts/serve-demo.mjs",
    "build": "vite build --config vite.config.js",
    "build:demo": "vite build --config vite.config.js --mode demo",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p test/types",
    "density-map": "node scripts/build-density-map.mjs",
    "region-map": "node scripts/build-region-map.mjs"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "dependencies": {
    "intl-messageformat": "^12.1.4",
    "troika-three-text": "^0.52.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}

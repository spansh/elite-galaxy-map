{
    "name": "elite-galaxy-map",
    "version": "0.1.0",
    "description": "Streaming three.js map of the Elite Dangerous galaxy that draws into any page element",
    "author": "Spansh",
    "type": "module",
    "main": "./src/index.js",
    "module": "./src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./spansh-loader-worker.js": "./examples/spansh-loader/spansh-loader-worker.js",
        "./read-lines.js": "./examples/spansh-loader/readLines.js",
        "./star-classes.js": "./examples/spansh-loader/starClasses.js",
        "./spansh-route.js": "./src/spanshRoute.js"
    },
    "files": [
        "src",
        "assets",
        "examples/spansh-loader",
        "scripts",
        "THIRD_PARTY_LICENSES.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "demo": "vite --config vite.config.js",
        "build": "vite build --config vite.config.js",
        "test": "vitest run",
        "lint": "eslint .",
        "density-map": "node scripts/build-density-map.mjs"
    },
    "peerDependencies": {
        "three": ">=0.170.0"
    },
    "dependencies": {
        "troika-three-text": "^0.52.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "three": "^0.186.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "license": "MIT",
    "packageManager": "pnpm@10.28.0"
}
